{
  "productName": "HexAi",
  "version": "1.0.0",
  "identifier": "com.hexai.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "HexAi",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src data: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src http://localhost:8000"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "resources": [],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "HexAi – inteligentny asystent AI",
    "longDescription": "Desktopowa aplikacja dla asystenta AI HexAi z obsługą czatu, RAG, generowaniem obrazów i transkrypcją audio."
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
